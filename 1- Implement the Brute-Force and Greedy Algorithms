function bruteForceMaxTasks(tasks) {
    if (tasks.length === 0) return [];
    const sorted = [...tasks].sort((a, b) => a.start - b.start);
    let maxCount = 0;
    let bestCombination = [];
    
    function findCombinations(index, lastEndTime, currentCombination) {
        if (index === sorted.length) {
            if (currentCombination.length > maxCount) {
                maxCount = currentCombination.length;
                bestCombination = [...currentCombination];
            }
            return;
        }
        findCombinations(index + 1, lastEndTime, currentCombination);
        const currentTask = sorted[index];
        if (currentTask.start >= lastEndTime) {
            currentCombination.push(currentTask);
            findCombinations(index + 1, currentTask.end, currentCombination);
            currentCombination.pop();
        }
    }
    
    findCombinations(0, 0, []);
    return bestCombination;
}

function greedyMaxTasks(tasks) {
    if (tasks.length === 0) return [];
    const sorted = [...tasks].sort((a, b) => a.end - b.end);
    const selected = [];
    let lastEnd = 0;
    
    for (const task of sorted) {
        if (task.start >= lastEnd) {
            selected.push(task);
            lastEnd = task.end;
        }
    }
    return selected;
}

function generateRandomTasks(count) {
    const tasks = [];
    for (let i = 0; i < count; i++) {
        const start = Math.floor(Math.random() * 1000);
        const duration = Math.floor(Math.random() * 50) + 1;
        tasks.push({ start, end: start + duration });
    }
    return tasks;
}

